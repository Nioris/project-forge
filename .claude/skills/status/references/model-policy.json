{
  "schemaVersion": 1,
  "policyVersion": "2026-08-18",
  "mode": "economy",
  "serviceTier": "default",
  "limits": {
    "maxPhaseSubagents": 2,
    "automaticMax": false,
    "automaticUltra": false
  },
  "defaultSubagent": {
    "model": "gpt-5.6-terra",
    "reasoning": "medium"
  },
  "phases": {
    "1": {
      "skill": "phase-1-analyze",
      "base": { "model": "gpt-5.6-terra", "reasoning": "high" },
      "maxSubagents": 1,
      "routes": {
        "metrics-conflict": {
          "kind": "escalation",
          "model": "gpt-5.6-sol",
          "reasoning": "high",
          "when": "Conflicting benchmark evidence or an unresolved KPI/content-budget contradiction"
        }
      }
    },
    "2": {
      "skill": "phase-2-design",
      "base": { "model": "gpt-5.6-sol", "reasoning": "high" },
      "maxSubagents": 2,
      "routes": {}
    },
    "3": {
      "skill": "phase-3-construct",
      "base": { "model": "gpt-5.6-terra", "reasoning": "medium" },
      "maxSubagents": 2,
      "routes": {
        "complex-logic": {
          "kind": "escalation",
          "model": "gpt-5.6-sol",
          "reasoning": "high",
          "when": "Complex game logic, economy, multiplayer, backend architecture, or repeated implementation failure"
        }
      }
    },
    "4": {
      "skill": "phase-4-visual",
      "base": { "model": "gpt-5.6-terra", "reasoning": "medium" },
      "maxSubagents": 2,
      "routes": {
        "art-direction": {
          "kind": "escalation",
          "model": "gpt-5.6-sol",
          "reasoning": "high",
          "when": "Creating or revising the style bible, target frame, or visual direction"
        }
      }
    },
    "5": {
      "skill": "phase-5-tech",
      "base": { "model": "gpt-5.6-terra", "reasoning": "high" },
      "maxSubagents": 2,
      "routes": {
        "repeated-failure": {
          "kind": "escalation",
          "model": "gpt-5.6-sol",
          "reasoning": "high",
          "when": "The same technical gate fails twice after evidence-backed fixes"
        },
        "payment-security": {
          "kind": "escalation",
          "model": "gpt-5.6-sol",
          "reasoning": "high",
          "when": "Payments, secrets, authentication, or non-standard multi-platform SDK conflicts are in scope"
        }
      }
    },
    "6": {
      "skill": "phase-6-listing",
      "base": { "model": "gpt-5.6-terra", "reasoning": "medium" },
      "maxSubagents": 1,
      "routes": {
        "mechanical-metadata": {
          "kind": "economy",
          "model": "gpt-5.6-luna",
          "reasoning": "low",
          "when": "Only deterministic metadata transformation or template filling remains"
        }
      }
    },
    "7": {
      "skill": "phase-7-test",
      "base": { "model": "gpt-5.6-terra", "reasoning": "high" },
      "maxSubagents": 2,
      "routes": {
        "unexplained-failure": {
          "kind": "escalation",
          "model": "gpt-5.6-sol",
          "reasoning": "high",
          "when": "A reproducible failure remains unexplained after normal diagnostics"
        }
      }
    },
    "8": {
      "skill": "phase-8-release",
      "base": { "model": "gpt-5.6-terra", "reasoning": "medium" },
      "maxSubagents": 2,
      "routes": {
        "gate-failure": {
          "kind": "escalation",
          "model": "gpt-5.6-terra",
          "reasoning": "high",
          "when": "A release verifier reports a non-trivial FAIL"
        },
        "moderation-rejection": {
          "kind": "escalation",
          "model": "gpt-5.6-sol",
          "reasoning": "high",
          "when": "The platform rejects the build or requirements conflict"
        }
      }
    },
    "9": {
      "skill": "phase-9-live",
      "base": { "model": "gpt-5.6-terra", "reasoning": "medium" },
      "maxSubagents": 1,
      "routes": {
        "metrics-collection": {
          "kind": "economy",
          "model": "gpt-5.6-luna",
          "reasoning": "low",
          "when": "Only collecting known metrics and updating a fixed table"
        }
      }
    }
  }
}
