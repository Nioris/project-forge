{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rodrik.dev/project-forge/schemas/agent-profile.schema.json",
  "title": "Project Forge whole-project agent lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agent", "model", "profile", "locked", "selectedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "agent": {
      "enum": ["gemini", "qwen", "deepseek", "glm", "minimax", "kimi"]
    },
    "model": { "type": "string", "minLength": 1, "maxLength": 160 },
    "profile": { "type": "string", "minLength": 1, "maxLength": 80 },
    "locked": { "const": true },
    "selectedAt": { "type": "string", "format": "date-time" }
  }
}
