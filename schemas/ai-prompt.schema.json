{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-forge.local/schemas/ai-prompt.schema.json",
  "title": "Project Forge AI image prompt pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "phase",
    "status",
    "purpose",
    "provider",
    "model",
    "size",
    "quality",
    "prompt",
    "output",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 2
    },
    "provider": {
      "enum": [
        "codex-native",
        "openai-api",
        "gigachat-api"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 2
    },
    "size": {
      "enum": [
        "1024x1024",
        "1024x1536",
        "1536x1024"
      ]
    },
    "quality": {
      "enum": [
        "low",
        "medium",
        "high",
        "auto"
      ]
    },
    "background": {
      "enum": [
        "opaque",
        "transparent",
        "auto"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 40
    },
    "negativeConstraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "type": "string",
      "minLength": 3
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": true
}
