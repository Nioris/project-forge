{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-forge.local/schemas/agent-contract.schema.json",
  "title": "Project Forge AgentContract registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contracts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "kind", "taskModes", "scope", "outputKind", "completion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source": { "type": "string", "pattern": "^\\.claude/agents/[a-z0-9-]+\\.md$" },
          "kind": { "enum": ["builder", "reviewer", "researcher"] },
          "taskModes": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["phase", "change", "review", "diagnose", "release"] } },
          "scope": {
            "type": "object", "additionalProperties": false, "required": ["read", "write"],
            "properties": {
              "read": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "write": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "outputKind": { "enum": ["builder", "reviewer", "researcher"] },
          "completion": {
            "type": "object", "additionalProperties": false,
            "required": ["requiresRecordedWrite", "requiresEvidence", "requiresVerifierPlan"],
            "properties": {
              "requiresRecordedWrite": { "type": "boolean" },
              "requiresEvidence": { "type": "boolean" },
              "requiresVerifierPlan": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
