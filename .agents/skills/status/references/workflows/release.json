{
  "schemaVersion": 1,
  "id": "release",
  "mode": "release",
  "start": "prepare",
  "nodes": {
    "prepare": { "type": "agent", "transitions": { "in_progress": "prepare", "completed": "verify", "user_decision_required": "wait-user", "retryable_failure": "repair", "provider_failure": "retry-provider", "environment_failure": "blocked", "blocked": "blocked" } },
    "verify": { "type": "verifier", "transitions": { "completed": "publish", "retryable_failure": "repair", "provider_failure": "retry-provider", "environment_failure": "blocked", "blocked": "blocked" } },
    "repair": { "type": "agent", "maxAttempts": 3, "exhaustedTo": "blocked", "transitions": { "in_progress": "repair", "completed": "verify", "retryable_failure": "repair", "provider_failure": "retry-provider", "environment_failure": "blocked", "blocked": "blocked" } },
    "publish": { "type": "system", "transitions": { "in_progress": "publish", "completed": "done", "provider_failure": "retry-provider", "environment_failure": "blocked", "blocked": "blocked" } },
    "retry-provider": { "type": "system", "maxAttempts": 3, "exhaustedTo": "blocked", "transitions": { "in_progress": "prepare", "provider_failure": "retry-provider", "environment_failure": "blocked", "blocked": "blocked" } },
    "wait-user": { "type": "decision", "transitions": { "in_progress": "prepare", "completed": "prepare", "user_decision_required": "wait-user", "blocked": "blocked" } },
    "blocked": { "type": "terminal", "transitions": {} },
    "done": { "type": "terminal", "transitions": {} }
  }
}
