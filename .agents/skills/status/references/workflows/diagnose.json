{
  "schemaVersion": 1,
  "id": "diagnose",
  "mode": "diagnose",
  "start": "inspect",
  "nodes": {
    "inspect": { "type": "agent", "transitions": { "in_progress": "inspect", "completed": "verify", "user_decision_required": "wait-user", "environment_failure": "blocked", "provider_failure": "retry-provider", "blocked": "blocked" } },
    "verify": { "type": "verifier", "transitions": { "completed": "done", "retryable_failure": "blocked", "environment_failure": "blocked", "provider_failure": "retry-provider", "blocked": "blocked" } },
    "retry-provider": { "type": "system", "maxAttempts": 3, "exhaustedTo": "blocked", "transitions": { "in_progress": "inspect", "provider_failure": "retry-provider", "environment_failure": "blocked", "blocked": "blocked" } },
    "wait-user": { "type": "decision", "transitions": { "in_progress": "inspect", "completed": "inspect", "user_decision_required": "wait-user", "blocked": "blocked" } },
    "blocked": { "type": "terminal", "transitions": {} },
    "done": { "type": "terminal", "transitions": {} }
  }
}
